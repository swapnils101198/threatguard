# ---- Backend ----
PORT=8787
NODE_ENV=development

# Threat-intel API keys (backend only — NEVER ship in the extension)
#
# Google Safe Browsing — free for non-commercial use.
#   https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=
#
# VirusTotal — free public tier (4 req/min, 500 req/day; non-commercial).
#   https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=
#
# URLhaus (abuse.ch) — free under Fair Use. Auth-Key required.
#   Sign up with at least two providers at https://auth.abuse.ch/ before
#   generating the key, or the key will not persist.
URLHAUS_AUTH_KEY=
#
# PhishTank — registration currently disabled by the provider.
#   Leave blank. The aggregator handles the resulting 403 gracefully.
PHISHTANK_API_KEY=

# Cache
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500